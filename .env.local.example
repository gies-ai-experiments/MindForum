# Required
OPENAI_API_KEY=sk-...
POSTGRES_URL=postgresql://mindforum:password@127.0.0.1:5432/mindforum
# Azure PostgreSQL example:
# POSTGRES_URL=postgresql://dlpostgresqladmin:<password>@dl-postgresqlserver-01.postgres.database.azure.com:5432/postgres?sslmode=require

# Azure OpenAI / Foundry
# If AZURE_OPENAI_ENDPOINT is set, the app uses Azure OpenAI instead of api.openai.com.
# AZURE_OPENAI_API_KEY may be used instead of OPENAI_API_KEY.
AZURE_OPENAI_ENDPOINT=https://dl-foundry-mindforum.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Optional
# For Azure OpenAI, these should be deployment names.
# Embedded model routing:
# - FAST: low-cost extraction and simple summaries
# - DEFAULT: normal @ai replies
# - STRONG: long context, files, briefs, and synthesis
# OPENAI_MODEL_FAST=gpt-4.1-mini
# OPENAI_MODEL_DEFAULT=gpt-4.1
# OPENAI_MODEL_STRONG=gpt-5.4
# Legacy fallback if the routed vars are absent:
# OPENAI_MODEL=gpt-5.4
# PORT=3000
# ADMIN_TOKEN=<some-long-random-hex>  # required to use /api/admin/seed

# Azure AD / Entra ID (optional — enables "Sign in with Illinois" self-registration)
# AZURE_AD_CLIENT_ID=<app-registration-client-id>
# AZURE_AD_CLIENT_SECRET=<client-secret>
# AZURE_AD_TENANT_ID=<university-tenant-id>
# NEXTAUTH_SECRET=<random-string>  # generate: openssl rand -base64 32

# Azure Communication Services (email notifications for room invitations & co-admin grants)
# Connection string from: az communication list-key --name mindforum-acs -g DL_ResourceGroup_01
# Leave both unset to disable email sending (invitations & grants still work normally).
# ACS_CONNECTION_STRING=endpoint=https://...;accesskey=...
# ACS_SENDER_ADDRESS=DoNotReply@8d575ffa-a77e-43b7-be5e-76054309ed26.azurecomm.net
